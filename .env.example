PORT=3000
NODE_ENV=development

# Groq API Key (https://console.groq.com/keys で無料取得)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 認証設定 (開発・個人利用は false、本番でAppleログイン必須にするなら true)
REQUIRE_AUTH=false

# データベース設定 (Render PostgreSQL 等を使用する場合。未設定ならインメモリ/モックモード)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname
