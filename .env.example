PORT=3000
NODE_ENV=development

# Keep provider keys on the server. Never put this value in the iOS app.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Required before enabling account sync, authenticated AI quotas, and purchases.
DATABASE_URL=
SESSION_JWT_SECRET=
APPLE_BUNDLE_ID=com.uuto.GoalPace
APP_STORE_APP_ID=6790040220
REQUIRE_AUTH=false

# These identifiers must exactly match the products created in App Store Connect.
IAP_MONTHLY_PRODUCT_ID=com.uuto.GoalPace.monthly
IAP_YEARLY_PRODUCT_ID=com.uuto.GoalPace.yearly
IAP_LIFETIME_PRODUCT_ID=com.uuto.GoalPace.lifetime
IAP_ENVIRONMENT=live

FREE_DAILY_LIMIT=10
